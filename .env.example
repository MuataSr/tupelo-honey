# Copy to .env and fill in. .env is gitignored and must never be committed.

# Flask session signing key. Required in production.
# Generate with:  openssl rand -hex 24
FLASK_SECRET=

# ── Optional AI tutor (bring your own model) ────────────────────────────────
# The Socratic tutor points at any OpenAI-compatible chat endpoint. Leave
# these unset to keep the tutor offline (the UI reports its models as offline).
# Local example: a llama-server (see start_tutor_servers.sh) on these ports.
TUPELO_TUTOR_ROUTER_URL=http://localhost:8082/v1/chat/completions
TUPELO_TUTOR_TEACHER_URL=http://localhost:8083/v1/chat/completions

# ── Signup (pilot cohort) ───────────────────────────────────────────────────
# Hard cap on registered users. Emails in PILOT_INTERNAL_EMAILS (comma-separated)
# are excluded from the count.
PILOT_SIGNUP_CAP=30
PILOT_INTERNAL_EMAILS=

# Optional: PILOT_BYPASS_KEY (a signup key that bypasses the cap),
#           PILOT_ADMIN_KEY   (waitlist admin access),
#           RESEND_API_KEY / RESEND_FROM
#           (dashboard-link + waitlist email via resend.com). With these unset,
#           the personal dashboard link is shown on screen instead of emailed.
